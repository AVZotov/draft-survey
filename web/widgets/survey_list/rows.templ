package surveylist

import (
	"fmt"
	"github.com/AVZotov/draft-survey/internal/format"
	"github.com/AVZotov/draft-survey/internal/handler/fields"
	"github.com/AVZotov/draft-survey/internal/handler/routes"
	"github.com/AVZotov/draft-survey/internal/service"
	"github.com/AVZotov/draft-survey/internal/types"
	"strings"
	"unicode"
)

templ Rows(rows []service.SurveyDTO, offset int, hasMore bool) {
	for _, row := range rows {
		@Row(row)
	}
	if hasMore {
		<div
			class="survey-load-more"
			hx-get={ fmt.Sprintf("/survey-list/rows?offset=%d&limit=%d", offset, fields.SurveyListLimit) }
			hx-trigger="intersect once"
			hx-swap="afterend"
		></div>
	}
}

templ Row(dto service.SurveyDTO) {
	<div
		x-data="{ open: false }"
		class="survey-row"
	>
		<!-- Vessel -->
		<div class="survey-cell">
			<div class="survey-cell__vessel-name">{ dto.Name }</div>
			<div class="survey-cell__vessel-imo">{ dto.IMO }</div>
		</div>
		<!-- Date -->
		<div class="survey-cell">
			<div class="survey-cell__date-main">{ dto.SurveyDate }</div>
			<div class="survey-cell__date-time">{ dto.SurveyTime }</div>
		</div>
		<!-- Port -->
		<div class="survey-cell">
			<div class="survey-cell__line">{ port(dto.LoadingPort) }</div>
			<div class="survey-cell__line survey-cell__line--dim">{ country(dto.LoadingCountry) }</div>
		</div>
		<!-- Destination -->
		<div class="survey-cell survey-cell--text">
			{ country(dto.DestinationCountry) }
		</div>
		<!-- Operation -->
		<span
			class={ templ.Classes(
    "badge",
    templ.KV("badge--load",  dto.Operation == fields.FieldOperationLoading),
    templ.KV("badge--disch", dto.Operation == fields.FieldOperationDischarge),
) }
		>
			{ dto.Operation }
		</span>
		<!-- Cargo -->
		<div class="survey-cell survey-cell--mono">
			{ weight(dto) }
		</div>
		<!-- Status -->
		<span
			class={ templ.Classes(
    "badge",
    templ.KV("badge--complete", dto.Status == types.SurveyStatusComplete),
    templ.KV("badge--progress", dto.Status == types.SurveyStatusInProgress),
    templ.KV("badge--draft",    dto.Status == types.SurveyStatusDraft),
) }
		>
			{ string(dto.Status) }
		</span>
		<!-- Actions -->
		<div
			class="survey-cell survey-cell--actions"
		>
			<button
				class="ia ia--open"
				title="View results"
			>
				<svg viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
			</button>
			<div class="row-menu" @click.outside="open = false">
				<button class="ia" @click="open = !open" title="More actions">
					<svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
				</button>
				<div class="row-menu__dropdown" x-show="open" x-cloak x-transition.origin.top.right>
					<a href={ templ.SafeURL("/survey/" + dto.SurveyID) } class="row-menu__item">
						<svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
						Edit survey
					</a>
					<button
						hx-confirm={ fmt.Sprintf("Warning:\n\tThis operation will permanently remove survey\n\tVessel: %s; IMO: %s", dto.Name, dto.IMO) }
						hx-delete={ routes.APIDeleteSurvey(dto.SurveyID) }
						hx-swap="delete transition:true"
						hx-target="closest .survey-row"
						class="row-menu__item row-menu__item--danger"
						type="button"
					>
						<svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6M14 11v6"></path><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path></svg>
						Delete survey
					</button>
				</div>
			</div>
		</div>
	</div>
}

func country(s string) string {
	c := transform(s)
	if c == "" {
		c = "No country Info"
	}
	return c
}

func port(s string) string {
	p := transform(s)

	if p == "" {
		p = "No port info"
	}

	return p
}

func weight(dto service.SurveyDTO) string {
	if dto.Status == types.SurveyStatusDraft || dto.Status == types.SurveyStatusInProgress {
		return "―"
	}
	return format.WeightFormatted(dto.CargoOnBoard)
}

func transform(s string) string {
	if s == "" {
		return ""
	}

	s = strings.ToLower(s)
	runes := []rune(s)
	runes[0] = unicode.ToUpper(runes[0])
	return string(runes)
}
