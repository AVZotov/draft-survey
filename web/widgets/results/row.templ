package results

// Вычисленное — яркое
templ Row(label string, value string, unit string) {
	<div class="result-row result-row--calc">
		<span class="result-row__label">{ label }</span>
		<span class="result-row__value">
			<span>{ value }</span>
			if unit != "" {
				<span class="result-row__unit">{ unit }</span>
			}
		</span>
	</div>
}

// Два введённых значения — блеклые
templ RowPair(label string, value1 string, value2 string, unit string) {
	<div class="result-row result-row--sub">
		<span class="result-row__label">{ label }</span>
		<span class="result-row__value">
			<span>{ value1 }</span>
			<span class="result-row__sep">/</span>
			<span>{ value2 }</span>
			if unit != "" {
				<span class="result-row__unit">{ unit }</span>
			}
		</span>
	</div>
}

// 3 field in row
templ RowTriple(label string, value1 string, value2 string, value3 string, unit string) {
	<div class="result-row result-row--sub">
		<span class="result-row__label">{ label }</span>
		<span class="result-row__value">
			<span>{ value1 }</span>
			<span class="result-row__sep">/</span>
			<span>{ value2 }</span>
			<span class="result-row__sep">/</span>
			<span>{ value3 }</span>
			if unit != "" {
				<span class="result-row__unit">{ unit }</span>
			}
		</span>
	</div>
}

// Формула справа — для PP&Keel
templ RowSub(label string, formula string) {
	<div class="result-row result-row--sub">
		<span class="result-row__label">{ label }</span>
		<span class="result-row__value result-row__value--dim">{ formula }</span>
	</div>
}
