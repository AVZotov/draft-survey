package results

import (
	"fmt"
	"github.com/AVZotov/draft-survey/web/components"
	"strings"
)

templ ActionBar(rp components.ResultProps) {
	<div class="action-bar action-bar--results">
		<div class="ab-info">
			<span class="ab-vessel">{ rp.Survey.VesselData.Name }</span>
			<span class="ab-meta">IMO{ rp.Survey.VesselData.IMO } · { strings.ToUpper(string(rp.Survey.CargoOperation.Operation)) }</span>
		</div>
		<div class="ab-btns">
			<a
				href={ fmt.Sprintf("/survey/%s/draft", rp.Survey.ID) }
				class="btn btn-primary"
			>
				<svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg>
				Back to Drafts
			</a>
			<button
				x-show="false"
				class="btn btn-ghost"
			>
				<svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v14a2 2 0 0 1-2 2z"></path><path d="M17 21v-8H7v8M7 3v5h8"></path></svg>
				Save
			</button>
			<button
				class="btn btn-ghost"
				x-show="false"
			>
				<svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
				Edit Drafts
			</button>
			<div
				class="print-wrap"
				x-data="{ open: false }"
				@click.outside="open = false"
				x-show="false"
			>
				<button class="btn btn-ghost" @click="open = !open">
					<svg viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
					Print Report
					<svg viewBox="0 0 24 24" style="width:10px;height:10px"><polyline points="6 9 12 15 18 9"></polyline></svg>
				</button>
				<div class="print-menu" x-show="open" x-cloak x-transition.origin.top.right>
					<div class="print-menu-title">Select report type</div>
					<button class="print-item">
						<svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
						<div>
							<div>Draft Survey Report</div>
							<div class="print-item-desc">Official report for signing</div>
						</div>
					</button>
					<button class="print-item">
						<svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
						<div>
							<div>Draft Survey — Internal Use</div>
							<div class="print-item-desc">Working copy with full detail</div>
						</div>
					</button>
					<button class="print-item">
						<svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
						<div>
							<div>Ballast Tanks Report</div>
							<div class="print-item-desc">BW / FW tanks breakdown</div>
						</div>
					</button>
				</div>
			</div>
			<button
				class="btn btn-primary"
				x-show="false"
			>
				<svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
				Edit &amp; Recalculate
			</button>
		</div>
	</div>
}
