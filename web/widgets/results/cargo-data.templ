package results

templ CargoData() {
	<div
		x-data="{
		cargoDeclared: data.survey.cargo_declared,
		cargoOnBoard: data.survey_results.cargo_on_board,
		get firstDraft() { return drafts[0] },
		get lastDraft() { return drafts[drafts.length - 1] },
		get firstSelectedDraft() { return drafts[firstIndex] },
		get lastSelectedDraft() { return drafts[lastIndex] },
		get firstResult() { return results[0] },
		get lastResult() { return results[results.length - 1] },
		get firstSelectedResult() { return results[firstIndex] },
		get lastSelectedResult() { return results[lastIndex] },
		}"
		class="cargo-data"
	>
		<div class="cargo-hero">
			<div>
				<div class="cargo-op-label">Cargo On Board</div>
				<div>
					<span class="cargo-weight" x-text="formatWeight(cargoOnBoard)"></span>
					<span class="cargo-weight-unit">MT</span>
				</div>
			</div>
			<div class="cargo-disc">
				Discrepancy from S/P: 
				<span x-text="cargoDeclared=== '' ? '—' : formatWeight(cargoOnBoard - cargoDeclared)"></span>
				<span class="result-row__unit">MT</span>
			</div>
		</div>
		<div class="cargo-top">
			<div class="cargo-cell">
				<div class="cargo-cell-label">Initial Draft</div>
				@CargoCellRow("Net Displacement", "formatWeight(firstResult?.draft_result?.net_displacement)", "MT")
				@CargoCellRow("Current DWT", "formatWeight(firstResult?.draft_result?.current_dwt)", "MT")
				@CargoCellRow("MMC", "formatWeight(firstResult?.draft_result?.mmc)", "m")
			</div>
			<div class="cargo-cell">
				<div class="cargo-cell-label">Final Draft</div>
				@CargoCellRow("Net Displacement", "formatWeight(lastResult?.draft_result?.net_displacement)", "MT")
				@CargoCellRow("Current DWT", "formatWeight(lastResult?.draft_result?.current_dwt)", "MT")
				@CargoCellRow("MMC", "formatWeight(lastResult?.draft_result?.mmc)", "m")
			</div>
			<div class="cargo-cell">
				<div class="cargo-cell-label">Declared</div>
			</div>
			<div class="cargo-cell">
				<div class="cargo-cell-label">Constants</div>
			</div>
		</div>
	</div>
}

templ CargoCellRow(label string, xText string, unit string) {
	<div class="cargo-cell-row">
		<span class="cargo-cell-name">{ label }</span>
		<span class="cargo-cell-val" x-text={ xText }></span>
		if unit != "" {
			<span class="cargo-cell-unit">{ unit }</span>
		}
	</div>
}
