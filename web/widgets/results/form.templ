package results

import (
	"fmt"
	"github.com/AVZotov/draft-survey/web/components"
)

templ Form(rp components.ResultProps) {
	<main
		x-data={ fmt.Sprintf(`resultsPage('%s', %d)`, rp.Alpine, rp.Lastindex) }
	>
		<!-- ── SURVEY SELECTOR BAR ─────────────────────────────────────── -->
		@Selector()
		<!-- ── MAIN ────────────────────────────────────────────────────── -->
		<div class="page-main page-main--results">
			<!-- Side-by-side columns -->
			<div class="results-grid">
				@Block("firstIndex", rp)
				@Block("secondIndex", rp)
			</div>
			<!-- ── CARGO RESULT ─────────────────────────────────────────── -->
			<div class="cargo-section">
				<div class="cargo-main">
					@CargoData()
					@CargoAlerts()
				</div>
			</div>
		</div>
		@ActionBar()
	</main>
}
