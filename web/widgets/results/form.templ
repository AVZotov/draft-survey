package results

import (
	"github.com/AVZotov/draft-survey/web/components"
)

templ Form(rp components.ResultProps) {
	<main>
		<!-- ── SURVEY SELECTOR BAR ─────────────────────────────────────── -->
		@Selector(rp)
		<!-- ── MAIN ────────────────────────────────────────────────────── -->
		<div class="page-main page-main--results">
			<!-- Side-by-side columns -->
			<div class="results-grid">
				@Block(rp, rp.FirstIndex, true)
				@Block(rp, rp.LastIndex, false)
			</div>
			<!-- ── CARGO RESULT ─────────────────────────────────────────── -->
			<div class="cargo-section">
				<div class="cargo-main">
					@CargoData(rp)
				</div>
			</div>
		</div>
		@ActionBar(rp)
	</main>
}
