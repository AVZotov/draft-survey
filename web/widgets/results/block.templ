package results

import (
	"fmt"
	"github.com/AVZotov/draft-survey/internal/format"
	"github.com/AVZotov/draft-survey/internal/types"
	"github.com/AVZotov/draft-survey/web/components"
)

templ Block(rp components.ResultProps, index int, isFirst bool) {
	{{
		draft := rp.Survey.Drafts[index]
		dt := rp.SurveyResult.DraftTotals[index]
		dr := dt.DraftResult
		blockID := "results-block-last"
		if isFirst {
			blockID = "results-block-first"
		}
	}}
	<div
		id={ blockID }
		class={ templ.Classes("draft-col",
      templ.KV("draft-col--ini", draft.Type == types.DraftTypeInitial),
      templ.KV("draft-col--fin", draft.Type == types.DraftTypeFinal),
      templ.KV("draft-col--mid", draft.Type == types.DraftTypeIntermediate),
      ) }
	>
		<div class="draft-col-header">
			<div class="col-label">
				<span class="col-dot"></span>
				<span>{ draftLabel(draft.Type, index) }</span>
			</div>
			<span class="col-mmc">{ fmt.Sprintf("MMC %.3f m", dr.MMC) }</span>
		</div>
		<div class="draft-col-body">
			<!-- SECTIONS POSITIONS -->
			@Section("1", "OBSERVED DRAFTS & MEANS") {
				@RowPair("Fwd P / Fwd S", format.Mark(draft.Marks.FwdPort.Value), format.Mark(draft.Marks.FwdStarboard.Value), "m")
				@RowPair("Mid P / Mid S", format.Mark(draft.Marks.MidPort.Value), format.Mark(draft.Marks.MidStarboard.Value), "m")
				@RowPair("Aft P / Aft S", format.Mark(draft.Marks.AftPort.Value), format.Mark(draft.Marks.AftStarboard.Value), "m")
				@Row("meanF", format.Weight(dr.MeanDraft.DraftFwdMean), "m")
				@Row("meanM", format.Weight(dr.MeanDraft.DraftMidMean), "m")
				@Row("meanA", format.Weight(dr.MeanDraft.DraftAftMean), "m")
			}
			@Section("2", "PP & Keel Corrections") {
				@RowPair("dFwd / Dir", format.Mark(draft.DistancePPFwd), draft.PPFwdDirection, "m")
				@RowPair("dMid / Dir", format.Mark(draft.DistancePPMid), draft.PPMidDirection, "m")
				@RowPair("dAft / Dir", format.Mark(draft.DistancePPAft), draft.PPAftDirection, "m")
				@RowTriple("Fk / Mk / Ak", format.Mark(draft.KeelFwd), format.Mark(draft.KeelMid), format.Mark(draft.KeelAft), "mm")
				@Row("FWD corrected wKeel", format.Weight(dr.DraftsWKeel.FwdDraftWKeel), "m")
				@Row("MID corrected wKeel", format.Weight(dr.DraftsWKeel.MidDraftWKeel), "m")
				@Row("AFT corrected wKeel", format.Weight(dr.DraftsWKeel.AftDraftWKeel), "m")
			}
			@Section("3", "LIST & TRIM") {
				@Row("Obs. Trim", format.Weight(dr.ObservedTrim), "m")
				@Row("True Trim", format.Weight(dr.TrueTrim), "m")
				@Row("List", format.Weight(dr.ListMeters), "m")
				@Row("Deflection", format.Weight(dr.Deflection), "cm")
			}
			@Section("4", "MEAN OF MEANS & MMC") {
				@Row("Mean F&A", format.Weight(dr.MeanFwdAft), "m")
				@Row("MMC wKeel", format.Weight(dr.MMC), "m")
			}
			@Section("5", "HYDROSTATIC INTERPOLATION AT MMC") {
				@Row("Displ. at MMC", format.Weight(dr.Hydrostatics.Displacement), "MT")
				@Row("TPC at MMC", format.Weight(dr.Hydrostatics.TPC), "MT/cm")
				@Row("LCF/LCA at MMC", format.Weight(dr.Hydrostatics.LCF), "m")
				@Row("ΔMTC (direct)", format.Weight(dr.DeltaMTC), "MT·m")
			}
			@Section("6", "TRIM LIST CORRECTION") {
				@Row("1st Trim Correction", format.Weight(dr.FirstTrimCorrection), "MT")
				@Row("2nd Trim Correction", format.Weight(dr.SecondTrimCorrection), "MT")
				@Row("List Correction", format.Weight(dr.ListCorrection), "MT")
				@Row("Total Trim & List Correction", format.Weight(dr.TotalTrimCorrection), "MT")
				@Row("Displ. corrected", format.Weight(dr.DisplacementCorrected), "MT")
			}
			@Section("7", "DENSITY CORRECTION") {
				@RowPair("Table / Dockwater Density", format.FloatOrEmpty(rp.Survey.VesselData.TableDensity), format.Mark(draft.Density), "t/m³")
				@Row("Density Correction", format.Weight(dr.DensityCorrection), "MT")
			}
			@Section("8", "DEDUCTIBLES") {
				@Row("HFO", format.Mark(draft.Deductibles.HFO), "MT")
				@Row("MDO", format.Mark(draft.Deductibles.MDO), "MT")
				@Row("LubOil", format.Mark(draft.Deductibles.LubOil), "MT")
				@Row("BilgeWater", format.Mark(draft.Deductibles.BilgeWater), "MT")
				@Row("SewageWater", format.Mark(draft.Deductibles.SewageWater), "MT")
				@Row("Others", format.Mark(draft.Deductibles.Others), "MT")
				@Row("Ballast Water", format.Weight(dr.TotalBwTanksWeight), "MT")
				@Row("FreshWater", format.Weight(dr.TotalFwTanksWeight), "MT")
				@Row("Total Deduct's", format.Weight(dr.TotalDeductibles), "MT")
			}
			@Section("9", "DISPLACEMENT & DWT") {
				@Row("Displacement Corr'd", format.Weight(dr.DisplacementCorrected), "MT")
				@Row("Net Displacement", format.Weight(dr.NetDisplacement), "MT")
				@Row("Current DWT", format.Weight(dr.CurrentDWT), "MT")
				@Row("Constant Calc", format.Weight(dt.TrueConstant), "MT")
			}
		</div>
	</div>
}

func draftLabel(t types.DraftType, index int) string {
	switch t {
	case types.DraftTypeInitial:
		return "Initial"
	case types.DraftTypeFinal:
		return "Final"
	default:
		return fmt.Sprintf("Intermediate %d", index)
	}
}
