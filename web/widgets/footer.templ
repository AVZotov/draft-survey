package widgets

templ Footer(version string) {
	<footer class="app-footer">
		<span class="app-footer-left">Draft Survey App Version: { version } · Open Source</span>
		<nav class="app-footer-right">
			<a href="#" class="app-footer-link">Documentation</a>
			<a href="#" class="app-footer-link">GitHub</a>
			<a href="#" class="app-footer-link">Report an Issue</a>
		</nav>
	</footer>
}
