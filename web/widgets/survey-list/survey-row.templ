package surveylist

import "github.com/AVZotov/draft-survey/internal/types/dto"

import "strings"
import "unicode"
import "github.com/AVZotov/draft-survey/internal/types"
import "github.com/AVZotov/draft-survey/internal/format"
import "github.com/AVZotov/draft-survey/internal/constants"

templ SurveyRow(dto dto.SurveyDTO) {
	<div class="survey-row">
		<!-- Vessel -->
		<div class="survey-cell">
			<div class="survey-cell__vessel-name">{ dto.Name }</div>
			<div class="survey-cell__vessel-imo">{ dto.IMO }</div>
		</div>
		<!-- Date -->
		<div class="survey-cell">
			<div class="survey-cell__date-main">{ dto.SurveyDate }</div>
			<div class="survey-cell__date-time">{ dto.SurveyTime }</div>
		</div>
		<!-- Port -->
		<div class="survey-cell">
			<div class="survey-cell__line">{ port(dto.LoadingPort) }</div>
			<div class="survey-cell__line survey-cell__line--dim">{ country(dto.LoadingCountry) }</div>
		</div>
		<!-- Destination -->
		<div class="survey-cell survey-cell--text">
			{ country(dto.DestinationCountry) }
		</div>
		<!-- Operation -->
		<span
			class={ templ.Classes(
    "badge",
    templ.KV("badge--load",  dto.Operation == string(constants.CargoLoading)),
    templ.KV("badge--disch", dto.Operation == string(constants.CargoDischarge)),
) }
		>
			{ dto.Operation }
		</span>
		<!-- Cargo -->
		<div class="survey-cell survey-cell--mono">
			{ weight(dto) }
		</div>
		<!-- Status -->
		<span
			class={ templ.Classes(
    "badge",
    templ.KV("badge--complete", dto.Status == types.SurveyStatusComplete),
    templ.KV("badge--progress", dto.Status == types.SurveyStatusInProgress),
    templ.KV("badge--draft",    dto.Status == types.SurveyStatusDraft),
) }
		>
			{ string(dto.Status) }
		</span>
		<!-- Actions -->
		<div class="survey-cell survey-cell--actions">
			<button class="ia ia--open" title="Open survey">
				<svg viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
			</button>
			<button class="ia" title="More">
				<svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
			</button>
		</div>
	</div>
}

func country(s string) string {
	c := transform(s)
	if c == "" {
		c = "No country Info"
	}
	return c
}

func port(s string) string {
	p := transform(s)

	if p == "" {
		p = "No port info"
	}

	return p
}

func weight(dto dto.SurveyDTO) string {
	if dto.Status == types.SurveyStatusDraft || dto.Status == types.SurveyStatusInProgress {
		return "―"
	}
	return format.WeightFormatted(dto.CargoOnBoard)
}

func transform(s string) string {
	if s == "" {
		return ""
	}

	s = strings.ToLower(s)
	runes := []rune(s)
	runes[0] = unicode.ToUpper(runes[0])
	return string(runes)
}
