package surveylist

import "github.com/AVZotov/draft-survey/internal/types/dto"
import "fmt"
import "github.com/AVZotov/draft-survey/internal/constants"

templ Rows(rows []dto.SurveyDTO, offset int, hasMore bool) {
	for _, row := range rows {
		@Row(row)
	}
	if hasMore {
		<div
			class="survey-load-more"
			hx-get={ fmt.Sprintf("/survey-list/rows?offset=%d&limit=%d", offset, constants.SurveyListLimit) }
			hx-trigger="revealed"
			hx-swap="outerHTML"
		></div>
	}
}
