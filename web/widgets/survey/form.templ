package survey

import (
	"github.com/AVZotov/draft-survey/internal/format"
	"github.com/AVZotov/draft-survey/internal/handler/fields"
	"github.com/AVZotov/draft-survey/internal/handler/routes"
	"github.com/AVZotov/draft-survey/web/components"
	"strconv"
)

templ NewSurveyForm(sp components.SurveyPageProps) {
	<main class="page-main">
		<div class="survey-layout">
			<a
				class="back-link"
				href={ routes.Home() }
			>
				@components.IconBack()
				Back to Dashboard
			</a>
			<h1 class="page-title">New Survey</h1>
			<p class="page-subtitle">
				Fill in the details below. You can proceed to draft readings at any time and return to complete missing fields.
			</p>
			<!-- ══ 1. SURVEY INFORMATION ═══════════════════════════════ -->
			@SurveyBlock(sp)
			<!-- ══ 2. VESSEL DATA ══════════════════════════════════════ -->
			@VesselBlock(sp)
			<!-- ══ 3. CALCULATION SETTINGS ══════════════ -->
			@VesselSettingBlock(sp)
		</div><!-- /survey-layout -->
	</main>
}

templ SurveyBlock(sp components.SurveyPageProps) {
	{{ survey := sp.Survey }}
	<div
		class="form-card"
		id="survey-survey-block"
		hx-post={ routes.APISurvey(survey.ID) }
		hx-include="this"
		hx-trigger="change changed delay:500ms"
		hx-swap="none"
		hx-sync="this:replace"
	>
		<div class="form-card-header">
			<div class="form-card-header-icon">
				<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
			</div>
			<span class="form-card-title">Survey Information</span>
			<span class="form-card-subtitle">Survey context & logistics</span>
		</div>
		<div class="form-section">
			<div class="field-col-4">
				@textProfileWrapper(fields.FieldJobNumber, survey.Job.JobNumber, "e.g. 345543_002", "Job No.", false)
				@intProfileWrapper(fields.FieldDSNumber, survey.Job.DSNumber, "DS No.", false)
				@textProfileWrapper(fields.FieldClient, survey.Job.Principal, "e.g. Company", "Principal / Client", false)
				<div class="filed">
					<label for={ fields.FieldCountryCode }>
						Country
						<span class="optional">(optional)</span>
					</label>
					@components.CountrySelectWrapper(routes.APISurvey(survey.ID), routes.APISurveyCountrySelect(survey.ID), fields.FieldCountryCode)
				</div>
			</div>
			<div class="field">
				<label>Cargo Operation <span class="required">*</span></label>
				<div class="operation-toggle">
					<input
						type="radio"
						id={ fields.FieldOperationLoading }
						name={ fields.FieldCargoOperation }
						value={ fields.FieldOperationLoading }
						checked?={ survey.CargoOperation.Operation !=  fields.FieldOperationDischarge }
					/>
					<label for={ fields.FieldOperationLoading }>
						<svg viewBox="0 0 24 24"><path d="M12 2v14M5 9l7 7 7-7"></path><path d="M5 20h14"></path></svg>
						Loading
					</label>
					<input
						type="radio"
						id={ fields.FieldOperationDischarge }
						name={ fields.FieldCargoOperation }
						value={ fields.FieldOperationDischarge }
						checked?={ survey.CargoOperation.Operation ==  fields.FieldOperationDischarge }
					/>
					<label for={ fields.FieldOperationDischarge }>
						<svg viewBox="0 0 24 24"><path d="M12 22V8M5 15l7-7 7 7"></path><path d="M5 4h14"></path></svg>
						Discharging
					</label>
				</div>
			</div>
			<div class="field-col-3">
				<div class="field">
					<label for={ fields.FieldCargo }>Cargo <span class="optional">(optional)</span></label>
					@components.StringSelectWrapper(routes.APISurvey(survey.ID), routes.APISurveyCargoSelect(survey.ID))
				</div>
				<div class="field">
					<label for={ fields.FieldPacking }>Packing <span class="optional">(optional)</span></label>
					@components.StringSelectWrapper(routes.APISurvey(survey.ID), routes.APISurveyPackingSelect(survey.ID))
				</div>
				@xInputProfileWrapper(fields.FieldCargoDeclared, survey.CargoDeclared, "Cargo Declared, MT", true)
			</div>
			<div class="field">
				<label for={ fields.FieldRemarks }>Remarks <span class="optional">(optional)</span></label>
				<textarea
					name={ fields.FieldRemarks }
					placeholder="Any observations, notes or disclaimers for the report…"
				>{ survey.Remarks }</textarea>
			</div>
		</div>
	</div>
}

templ VesselBlock(sp components.SurveyPageProps) {
	{{ survey := sp.Survey }}
	<div
		class="form-card"
		id="survey-vessel-block"
		hx-post={ routes.APISurvey(survey.ID) }
		hx-include="this"
		hx-trigger="change changed delay:500ms"
		hx-swap="none"
		hx-sync="this:replace"
	>
		<div class="form-card-header">
			<div class="form-card-header-icon">
				<svg viewBox="0 0 24 24"><path d="M3 17l2-7h14l2 7H3z"></path><path d="M8 10V6h8v4"></path><path d="M12 6V3"></path></svg>
			</div>
			<span class="form-card-title">Vessel Data</span>
			<span class="form-card-subtitle">From vessel's certificates</span>
		</div>
		<div class="form-section">
			<div class="field-col-4">
				@textProfileWrapper(fields.FieldVesselName, survey.VesselData.Name, "e.g. OCEAN CHEERS", "Vessel Name", true)
				@textProfileWrapper(fields.FieldIMO, survey.VesselData.IMO, "e.g. 9233387", "IMO No.", false)
				<div class="filed">
					<label for={ fields.FieldFlagCountryCode }>
						Vessel Flag<span class="optional">(optional)</span>
					</label>
					@components.CountrySelectWrapper(routes.APISurvey(survey.ID), routes.APISurveyFlagSelect(survey.ID), fields.FieldFlagCountryCode)
				</div>
				<div class="field">
					<label for={ fields.FieldBuiltYear }>Built Year <span class="optional">(optional)</span></label>
					<input x-data x-mask="9999" name={ fields.FieldBuiltYear } value={ format.IntOrEmpty(survey.VesselData.BuiltYear) } placeholder="e.g. 2002" type="text"/>
				</div>
			</div>
			<div class="field-col-3">
				@xInputProfileWrapper(fields.FieldConstDeclared, survey.ConstantDeclared, "Const declared", true)
				@xInputProfileWrapper(fields.FieldTableDensity, survey.VesselData.TableDensity, "Table Density, t/m³", true)
				<div class="field">
					<label>Holds Total <span class="optional">(optional)</span></label>
					<div class="select-wrap">
						{{ ht := 0 }}
						{{
							if survey.VesselData.HoldsTotal != nil {
								ht = *survey.VesselData.HoldsTotal
							}
						}}
						<select name={ fields.FieldHoldsTotal }>
							<option value="0" selected?={ ht == 0 }>—</option>
							for i := 1; i <= 10; i++ {
								<option
									value={ strconv.Itoa(i) }
									selected?={ ht == i }
								>{ strconv.Itoa(i) }</option>
							}
						</select>
					</div>
				</div>
			</div>
		</div>
		<div class="form-section">
			<div class="field-col-4">
				@xInputProfileWrapper(fields.FieldLightship, survey.VesselData.Lightship, "Lightship, MT", true)
				@xInputProfileWrapper(fields.FieldLBP, survey.VesselData.LBP, "LBP, m", true)
				@xInputProfileWrapper(fields.FieldBreadth, survey.VesselData.Breadth, "Breadth, m", true)
				@xInputProfileWrapper(fields.FieldDepth, survey.VesselData.Depth, "Depth, m", false)
				@xInputProfileWrapper(fields.FieldSummerDraft, survey.VesselData.SummerDraft, "Summer Draft, m", true)
				@xInputProfileWrapper(fields.FieldSummerDWT, survey.VesselData.SummerDWT, "Summer DWT, MT", true)
				@xInputProfileWrapper(fields.FieldSummerTPC, survey.VesselData.SummerTPC, "Summer TPC, MT/cm", true)
				@xInputProfileWrapper(fields.FieldSummerFreeboard, survey.VesselData.SummerFreeboard, "Summer Freeboard, m", true)
			</div>
		</div>
	</div>
}

templ VesselSettingBlock(sp components.SurveyPageProps) {
	{{ survey := sp.Survey }}
	<div
		class="form-card"
		id="survey-settings-block"
		hx-post={ routes.APISurvey(survey.ID) }
		hx-include="this"
		hx-trigger="change changed delay:500ms"
		hx-swap="none"
		hx-sync="this:replace"
	>
		<div class="form-card-header">
			<div class="form-card-header-icon">
				<svg viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"></rect><path d="M8 6h8M8 10h8M8 14h4"></path></svg>
			</div>
			<span class="form-card-title">Calculation Settings</span>
			<span class="form-card-subtitle">UNECE 1992 method parameters</span>
		</div>
		<div class="form-section">
			<div class="field">
				<label>MMC Calculation Method <span class="required">*</span></label>
				<div class="method-options">
					<div class="method-option">
						<input
							type="radio"
							name={ fields.FieldMMCMethod }
							id="mmc-standard"
							value="marine"
							checked?={ survey.VesselData.VesselType != "river" && survey.VesselData.VesselType != "barge" }
						/>
						<label for="mmc-standard">
							<span class="method-label-title">Standard</span>
							<span class="method-label-formula">(f + 6m + a) / 8</span>
							<span class="method-label-desc">Sea vessel</span>
						</label>
					</div>
					<div class="method-option">
						<input
							type="radio"
							name={ fields.FieldMMCMethod }
							id="mmc-river"
							value="river"
							checked?={ survey.VesselData.VesselType == "river" }
						/>
						<label for="mmc-river">
							<span class="method-label-title">River</span>
							<span class="method-label-formula">(f + 4m + a) / 6</span>
							<span class="method-label-desc">River vessel</span>
						</label>
					</div>
					<div class="method-option">
						<input
							type="radio"
							name={ fields.FieldMMCMethod }
							id="mmc-barge"
							value="barge"
							checked?={ survey.VesselData.VesselType == "barge" }
						/>
						<label for="mmc-barge">
							<span class="method-label-title">Barge</span>
							<span class="method-label-formula">(3f + 14m + 3a) / 20</span>
							<span class="method-label-desc">Barge</span>
						</label>
					</div>
				</div>
			</div>
		</div>
		<div class="form-section">
			<div class="field">
				<label>Correction Method <span class="required">*</span></label>
				<div class="correction-options">
					<div class="method-option">
						<input
							type="radio"
							name={ fields.FieldCorrMethod }
							id="corr-full"
							value="Full LBP"
							checked?={ survey.VesselData.CorrectionMethod != "Half LBP" }
						/>
						<label for="corr-full">
							<span class="method-label-title">Full LBP</span>
							<span class="method-label-desc">Standard — sea vessels</span>
						</label>
					</div>
					<div class="method-option">
						<input
							type="radio"
							name={ fields.FieldCorrMethod }
							id="corr-half"
							value="Half LBP"
							checked?={ survey.VesselData.CorrectionMethod == "Half LBP" }
						/>
						<label for="corr-half">
							<span class="method-label-title">Half LBP</span>
							<span class="method-label-desc">River vessels only</span>
						</label>
					</div>
				</div>
			</div>
		</div>
		<div class="form-section">
			<div class="field">
				<label>LCF Detection <span class="required">*</span></label>
				<div class="lcf-options">
					<div class="method-option">
						<input
							type="radio"
							disabled
							name={ fields.FieldLCFDetection }
							id="lcf-auto"
							value="auto"
							checked?={ !survey.VesselData.IsLcfDetectionManual }
						/>
						<label for="lcf-auto">
							<span class="method-label-title">Auto</span>
							<span class="method-label-desc">Direction from hydrostatic table</span>
						</label>
					</div>
					<div class="method-option">
						<input
							type="radio"
							name={ fields.FieldLCFDetection }
							id="lcf-manual"
							value="manual"
							checked?={ survey.VesselData.IsLcfDetectionManual }
						/>
						<label for="lcf-manual">
							<span class="method-label-title">Manual</span>
							<span class="method-label-desc">Set direction per draft manually</span>
						</label>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ xInputProfileWrapper(name string, value *float64, label string, required bool) {
	<div class="field">
		<label for={ name }>
			{ label }
			if required {
				<span class="required">*</span>
			} else {
				<span class="optional">(optional)</span>
			}
		</label>
		@components.XInput(name, value)
	</div>
}

templ textProfileWrapper(name, value, placeholder, label string, required bool) {
	<div class="field">
		<label for={ name }>
			{ label }
			if required {
				<span class="required">*</span>
			} else {
				<span class="optional">(optional)</span>
			}
		</label>
		<input name={ name } value={ value } placeholder={ placeholder } type="text"/>
	</div>
}

templ intProfileWrapper(name string, value *int, label string, required bool) {
	<div class="field">
		<label
			for={ name }
		>
			{ label }
			if required {
				<span class="required">*</span>
			} else {
				<span class="optional">(optional)</span>
			}
		</label>
		<input x-data x-mask="999999" name={ name } value={ format.IntOrEmpty(value) } placeholder="e.g. 1" type="text"/>
	</div>
}
