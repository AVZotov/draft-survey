package profile

import "github.com/AVZotov/draft-survey/internal/handler/chi/fields"
import "github.com/AVZotov/draft-survey/web/components"
import "github.com/AVZotov/draft-survey/internal/types"
import "github.com/AVZotov/draft-survey/internal/handler/chi/routes"

templ Form(user *types.User) {
	{{
		var u types.User
		if user == nil {
			u = types.User{}
		} else {
			u = *user
		}
	}}
	<div
		x-data="{
			firstname: '',
			lastname: '',
			get isActive() { return this.firstname !== '' && this.lastname !== '' },
		}"
		class="page-main"
	>
		<div class="setup-card">
			<div class="setup-intro">
				if user == nil {
					<p class="setup-step-label">First Run · Setup</p>
				}
				<h1 class="setup-title">Surveyor Profile</h1>
				<p class="setup-description">
					This information will appear on all generated reports.
					You only need to fill this in once — it can be edited later in Settings.
				</p>
			</div>
			<div
				class="form-card"
				hx-on::before-request={ templ.JSFuncCall("requireFields", []string{fields.FieldFirstName, fields.FieldLastName}) }
			>
				<!-- Personal Information -->
				@PersonalInfo(u)
				<!-- Company & Certification -->
				@CompanyInfo(u)
				<!-- Signature -->
				@Signature()
				<!-- Form footer -->
				<div class="form-footer">
					<span class="form-footer-hint">
						Fields marked <span class="required">*</span> are required
					</span>
					<a
						class="btn"
						href={ routes.Home() }
						x-on:click="!isActive && $event.preventDefault()"
						x-bind:class="isActive ? 'btn-primary' : 'btn-ghost'"
					>
						<svg viewBox="0 0 24 24">
							<path d="M5 12h14M12 5l7 7-7 7"></path>
						</svg>
						Continue
					</a>
				</div>
			</div><!-- /form-card -->
			<!-- Info note -->
			<div class="info-banner">
				@components.IconInfo()
				<p class="info-banner-text">
					All profile data is stored locally on this device only.
					No information is transmitted to external servers.
				</p>
			</div>
		</div><!-- /setup-card -->
	</div>
}

templ PersonalInfo(user types.User) {
	<div
		class="form-section"
		hx-post={ routes.APIProfile() }
		hx-trigger="change changed delay:500ms"
		hx-include="this"
		hx-swap="none"
	>
		<p class="form-section-title">Personal Information</p>
		<div class="field-row">
			<div class="field">
				<label for={ fields.FieldFirstName }>
					First Name 
					<span class="required">*</span>
				</label>
				<input
					type="text"
					id={ fields.FieldFirstName }
					name={ fields.FieldFirstName }
					value={ user.FirstName }
					placeholder="e.g. John"
					x-model.fill="firstname"
					required
				/>
			</div>
			<div class="field">
				<label for={ fields.FieldLastName }>
					Last Name 
					<span class="required">*</span>
				</label>
				<input
					type="text"
					id={ fields.FieldLastName }
					name={ fields.FieldLastName }
					value={ user.LastName }
					placeholder="e.g. Dow"
					x-model.fill="lastname"
					required
				/>
			</div>
			<div class="field">
				<label for={ fields.FieldPosition }>
					Position / Title
					<span class="optional">(optional)</span>
				</label>
				<input
					type="text"
					id={ fields.FieldPosition }
					name={ fields.FieldPosition }
					value={ user.Position }
					placeholder="e.g. Senior Marine Surveyor"
				/>
			</div>
			<div class="field">
				<label for={ fields.FieldEmail }>
					Email 
					<span class="optional">(optional)</span>
				</label>
				<input
					type="email"
					id={ fields.FieldEmail }
					name={ fields.FieldEmail }
					value={ user.Email }
					placeholder="surveyor@example.com"
				/>
				<p class="field-hint">Used in reports only. Stored locally, never transmitted to any server.</p>
			</div>
		</div>
	</div>
}

templ CompanyInfo(user types.User) {
	<div
		class="form-section"
		hx-post={ routes.APIProfile() }
		hx-trigger="change changed delay:500ms"
		hx-include="this"
		hx-swap="none"
	>
		<p class="form-section-title">Company & Certification</p>
		<div class="field-row">
			<div class="field">
				<label for={ fields.FieldCompany }>
					Company Name 
					<span class="optional">(optional)</span>
				</label>
				<input
					type="text"
					id={ fields.FieldCompany }
					name={ fields.FieldCompany }
					value={ user.Company }
					placeholder="e.g. Marine Survey Services Ltd."
				/>
			</div>
			<div class="field">
				<label for={ fields.FieldLicense }>Licence / Certificate No. <span class="optional">(optional)</span></label>
				<input
					type="text"
					id={ fields.FieldLicense }
					name={ fields.FieldLicense }
					value={ user.License }
					placeholder="e.g. CRS-00421"
				/>
			</div>
			<div class="field">
				<label for={ fields.FieldCountry }>
					Country 
					<span class="optional">(optional)</span>
				</label>
				<div class="select-wrap">
					<select
						id={ fields.FieldCountry }
						name={ fields.FieldCountry }
					>
						<option value="" disabled selected>Select country</option>
						<option>Russia</option>
						<option>Netherlands</option>
						<option>Singapore</option>
						<option>United Kingdom</option>
						<option>Germany</option>
						<option>Switzerland</option>
						<option>Other</option>
					</select>
				</div>
			</div>
		</div>
	</div>
}

templ Signature() {
	<div
		class="form-section"
		hx-post={ routes.APIProfile() }
		hx-encoding="multipart/form-data"
		hx-trigger="change changed"
		hx-include="this"
		hx-swap="none"
	>
		<p class="form-section-title">Signature for Reports</p>
		<label for={ fields.FieldSignature } class="signature-upload">
			<input type="file" id={ fields.FieldSignature } name={ fields.FieldSignature } accept="image/png,image/jpeg"/>
			<svg class="signature-upload-icon" viewBox="0 0 24 24">
				<path d="M12 15V3M7 8l5-5 5 5"></path>
				<path d="M4 17v1a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1"></path>
			</svg>
			<p class="signature-upload-text">Click to upload signature image</p>
			<p class="signature-upload-hint">PNG with transparent background recommended · max 2 MB</p>
		</label>
	</div>
}
