package drafts

import (
	"fmt"
	"github.com/AVZotov/draft-survey/internal/calculation"
	"github.com/AVZotov/draft-survey/internal/constants"
	"github.com/AVZotov/draft-survey/internal/format"
	"github.com/AVZotov/draft-survey/web/components"
	"strconv"
)

templ Deductibles(dp components.DraftPageProps, draftIndex int, dr calculation.DraftResult) {
	{{ draft := dp.Survey.Drafts[draftIndex] }}
	<!-- Deductibles and Table density-->
	<div class="deduct-section">
		<div class="sec-title">Deductibles &amp; Density</div>
		<div class="deduct-grid">
			<div class="df">
				<label>Tbl Density</label>
				<input name={ fmt.Sprintf("%s-%d", constants.TableDensity, draftIndex) } value={ format.FloatOrEmpty(dp.Survey.VesselData.TableDensity) } type="number" placeholder="0.000" step="any"/>
			</div>
			<div class="df">
				<label>HFO, MT</label>
				<input name={ fmt.Sprintf("%s-%d", constants.HFO, draftIndex) } value={ format.FloatOrEmpty(draft.Deductibles.HFO) } type="number" placeholder="0.000" step="any"/>
			</div>
			<div class="df">
				<label>MDO, MT</label>
				<input name={ fmt.Sprintf("%s-%d", constants.MDO, draftIndex) } value={ format.FloatOrEmpty(draft.Deductibles.MDO) } type="number" placeholder="0.000" step="any"/>
			</div>
			<div class="df">
				<label>Lube Oil, MT</label>
				<input name={ fmt.Sprintf("%s-%d", constants.LubOil, draftIndex) } value={ format.FloatOrEmpty(draft.Deductibles.LubOil) } type="number" placeholder="0.000" step="any"/>
			</div>
			<div class="df">
				<label>Bilge Water, MT</label>
				<input name={ fmt.Sprintf("%s-%d", constants.BilgeWater, draftIndex) } value={ format.FloatOrEmpty(draft.Deductibles.BilgeWater) } type="number" placeholder="0.000" step="any"/>
			</div>
			<div class="df">
				<label>DockW Density</label>
				<input name={ fmt.Sprintf("%s-%d", constants.DockwaterDensity, draftIndex) } value={ format.FloatOrEmpty(draft.Density) } type="number" placeholder="0.000" step="any"/>
			</div>
			<div class="df">
				<label>Others, MT</label>
				<input name={ fmt.Sprintf("%s-%d", constants.Others, draftIndex) } value={ format.FloatOrEmpty(draft.Deductibles.Others) } type="number" placeholder="0.000" step="any"/>
			</div>
			<div class="df">
				<label>Ballast Water, MT</label>
				<input readonly name={ fmt.Sprintf("%s-%d", constants.BWTank, draftIndex) } placeholder="0.000" step="any" type="number"/>
			</div>
			<div class="df">
				<label>Fresh Water, MT</label>
				<input readonly name={ fmt.Sprintf("%s-%d", constants.FWTank, draftIndex) } placeholder="0.000" step="any" type="number"/>
			</div>
			<div class="df">
				<label>Total Deduct, MT</label>
				<input readonly name={ fmt.Sprintf("%s-%d", constants.TotalDeduct, draftIndex) } value={ dr.TotalDeductibles } type="number" placeholder="0.000" step="any"/>
			</div>
			<div class="df">
				<label>Const Declared, MT</label>
				<input readonly name={ fmt.Sprintf("%s-%d", constants.ConstDeclared, draftIndex) } value={ format.FloatOrEmpty(dp.Survey.ConstantDeclared) } type="number" placeholder="0.000" step="any"/>
			</div>
			<div class="df">
				<label>Cargo Declared, MT</label>
				<input readonly name={ fmt.Sprintf("%s-%d", constants.CargoDeclared, draftIndex) } value={ format.FloatOrEmpty(dp.Survey.CargoDeclared) } type="number" placeholder="0.000" step="any"/>
			</div>
		</div>
		<button
			class="btn btn-ghost--ini"
			hx-post={ "/api/v1/survey/" + dp.Survey.ID + "/draft/save?redirect=/survey/" + dp.Survey.ID + "/tanks/" + strconv.Itoa(draftIndex) }
			hx-include="#draft-form"
		>
			<svg viewBox="0 0 24 24">
				<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
				<polyline points="9 22 9 12 15 12 15 22"></polyline>
			</svg>
			BW / FW Tanks →
		</button>
	</div>
}
