package drafts

import (
	"fmt"
	"github.com/AVZotov/draft-survey/web/components"
)

templ DraftForm(dp components.DraftPageProps) {
	<main class="page-main">
		<form id="draft-form">
			<div class="page-wrap">
				<div class="page-top">
					<a href="#" class="back-link">
						<svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg>
						Back to Survey Data
					</a>
					<h1 class="page-title">Draft Readings</h1>
					<p class="page-meta">
						{ dp.Survey.VesselData.Name } · IMO { dp.Survey.VesselData.IMO } · { dp.Survey.CargoOperation.Operation } · { dp.Survey.CargoOperation.PlaceOfInspection }
					</p>
				</div>
				for i, _ := range dp.Survey.Drafts {
					if i > 0 {
						@divider(i, len(dp.Survey.Drafts))
					}
					@DraftBlock(dp, i)
				}
			</div>
		</form>
	</main>
}

templ divider(index, totalDrafts int) {
	<div class="draft-divider">
		<div class="dd-line"></div>
		<span class="dd-label">↓ { draftDividerLabel(index, totalDrafts) }</span>
		<div class="dd-line"></div>
	</div>
}

func draftPrefix(i, total int) string {
	if i == 0 {
		return "i"
	}
	if i == total-1 {
		return "f"
	}
	return fmt.Sprintf("m%d", i)
}

func draftDividerLabel(i, total int) string {
	if i == total-1 {
		return "Final Draft"
	}
	return fmt.Sprintf("Intermediate Draft %d", i+1)
}
