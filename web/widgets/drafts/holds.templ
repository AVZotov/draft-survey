package drafts

import (
	"fmt"
	"github.com/AVZotov/draft-survey/internal/handler/fields"
	"github.com/AVZotov/draft-survey/internal/handler/routes"
	"github.com/AVZotov/draft-survey/web/components"
	"strconv"
)

templ HoldsBar(dp components.DraftPageProps, draftIndex int) {
	{{ draft := dp.Survey.Drafts[draftIndex] }}
	{{ total := 0 }}
	{{ if dp.Survey.VesselData.HoldsTotal != nil { total = *dp.Survey.VesselData.HoldsTotal } }}
	<div
		class="holds-bar"
		hx-put={ routes.APIDraftUpdate(dp.Survey.ID, draftIndex) }
		hx-trigger="change"
		hx-include="this"
	>
		<span class="holds-bar__label">Holds to load</span>
		<div class="holds-bar__circles">
			for i := 1; i <= total; i++ {
				{{ active := isHoldActive(draft.HoldsActive, i) }}
				<label class="holds-bar__hold">
					<input
						type="checkbox"
						name={ fmt.Sprintf("%s-%d", fields.FieldHoldsActive, draftIndex) }
						value={ strconv.Itoa(i) }
						checked?={ active }
					/>
					<span class="holds-bar__dot">{ strconv.Itoa(i) }</span>
				</label>
			}
		</div>
	</div>
}

func isHoldActive(active []int, hold int) bool {
	for _, h := range active {
		if h == hold {
			return true
		}
	}
	return false
}
