package drafts

import (
	"fmt"
	"github.com/AVZotov/draft-survey/internal/constants"
	"github.com/AVZotov/draft-survey/internal/format"
	"github.com/AVZotov/draft-survey/internal/handler/fields"
	"github.com/AVZotov/draft-survey/internal/handler/routes"
	"github.com/AVZotov/draft-survey/internal/types"
	"github.com/AVZotov/draft-survey/web/components"
)

templ Hydrostatics(dp components.DraftPageProps, draftIndex int, dr types.DraftResult) {
	{{ draft := dp.Survey.Drafts[draftIndex] }}
	<!-- Hydrostatic data -->
	<div class="hydro-section">
		<div class="sec-title">
			<span>Hydrostatic Data</span>
			<span>
				@LBM(dr, draftIndex, false)
				<span class="sec-title-method">{ format.MMCShortFormula(dp.Survey.VesselData.VesselType) } { format.LBPCorrection(dp.Survey.VesselData.CorrectionMethod) }</span>
			</span>
		</div>
		<div
			class="hydro-grid"
			hx-put={ routes.APIDraftUpdate(dp.Survey.ID, draftIndex) }
			hx-target={ fmt.Sprintf("#%s-%d", constants.MMCRow, draftIndex) }
			hx-include={ fmt.Sprintf("#%s-%d, #%s-%d", constants.UHydroRow, draftIndex, constants.LHydroRow, draftIndex) }
			hx-trigger="change changed delay:500ms"
			hx-sync="this:replace"
		>
			<!-- Header row -->
			<div class="hydro-grid-cell hydro-grid-cell--header"></div>
			<div class="hydro-grid-cell hydro-grid-cell--header">Draft, m</div>
			<div class="hydro-grid-cell hydro-grid-cell--header">Displ, MT</div>
			<div class="hydro-grid-cell hydro-grid-cell--header">TPC, MT/cm</div>
			<div class="hydro-grid-cell hydro-grid-cell--header">LCF / LCA, m</div>
			<!-- Upper row -->
			<div
				class="hydro-row"
				id={ fmt.Sprintf("%s-%d", constants.UHydroRow, draftIndex) }
			>
				<div class="hydro-grid-cell hydro-grid-cell--label">Upper</div>
				<div class="hydro-grid-cell">
					@components.XInput(fmt.Sprintf("%s-%d", fields.FieldUDraft, draftIndex), draft.HydrostaticRows[0].Draft)
				</div>
				<div class="hydro-grid-cell">
					@components.XInput(fmt.Sprintf("%s-%d", fields.FieldUDisp, draftIndex), draft.HydrostaticRows[0].Displacement)
				</div>
				<div class="hydro-grid-cell">
					@components.XInput(fmt.Sprintf("%s-%d", fields.FieldUTPC, draftIndex), draft.HydrostaticRows[0].TPC)
				</div>
				<div class="hydro-grid-cell lcf-field">
					@components.XInput(fmt.Sprintf("%s-%d", fields.FieldULCF, draftIndex), draft.HydrostaticRows[0].LCF)
					<select class="di-badge" name={ fmt.Sprintf("%s-%d", fields.FieldULCFDir, draftIndex) }>
						<option value="" selected?={ draft.HydrostaticRows[0].LCFDirection == types.LCFDirection("") }>—</option>
						<option value={ types.LCFDirectionForward } selected?={ draft.HydrostaticRows[0].LCFDirection == types.LCFDirectionForward }>{ types.LCFDirectionForward }</option>
						<option value={ types.LCFDirectionAft } selected?={ draft.HydrostaticRows[0].LCFDirection == types.LCFDirectionAft }>{ types.LCFDirectionAft }</option>
						<option value={ types.LCFDirectionFromAP } selected?={ draft.HydrostaticRows[0].LCFDirection == types.LCFDirectionFromAP }>{ types.LCFDirectionFromAP }</option>
					</select>
				</div>
			</div>
			<!-- MMC row -->
			@MMCRow(dp.Survey, draftIndex, dr, false)
			<!-- Lower row -->
			<div
				class="hydro-row"
				id={ fmt.Sprintf("%s-%d", constants.LHydroRow, draftIndex) }
			>
				<div class="hydro-grid-cell hydro-grid-cell--label">Lower</div>
				<div class="hydro-grid-cell">
					@components.XInput(fmt.Sprintf("%s-%d", fields.FieldLDraft, draftIndex), draft.HydrostaticRows[1].Draft)
				</div>
				<div class="hydro-grid-cell">
					@components.XInput(fmt.Sprintf("%s-%d", fields.FieldLDisp, draftIndex), draft.HydrostaticRows[1].Displacement)
				</div>
				<div class="hydro-grid-cell">
					@components.XInput(fmt.Sprintf("%s-%d", fields.FieldLTPC, draftIndex), draft.HydrostaticRows[1].TPC)
				</div>
				<div class="hydro-grid-cell lcf-field">
					@components.XInput(fmt.Sprintf("%s-%d", fields.FieldLLCF, draftIndex), draft.HydrostaticRows[1].LCF)
					<select class="di-badge" name={ fmt.Sprintf("%s-%d", fields.FieldLLCFDir, draftIndex) }>
						<option value="" selected?={ draft.HydrostaticRows[1].LCFDirection == types.LCFDirection("") }>—</option>
						<option value={ types.LCFDirectionForward } selected?={ draft.HydrostaticRows[1].LCFDirection == types.LCFDirectionForward }>{ types.LCFDirectionForward }</option>
						<option value={ types.LCFDirectionAft } selected?={ draft.HydrostaticRows[1].LCFDirection == types.LCFDirectionAft }>{ types.LCFDirectionAft }</option>
						<option value={ types.LCFDirectionFromAP } selected?={ draft.HydrostaticRows[1].LCFDirection == types.LCFDirectionFromAP }>{ types.LCFDirectionFromAP }</option>
					</select>
				</div>
			</div>
		</div>
		<div
			class="mtc-grid"
			hx-trigger="change changed delay:500ms"
			hx-put={ routes.APIDraftUpdate(dp.Survey.ID, draftIndex) }
			hx-include="this"
			hx-target={ fmt.Sprintf("#%s-%d", constants.DelataMtc, draftIndex) }
			hx-select={ fmt.Sprintf("#%s-%d", constants.DelataMtc, draftIndex) }
			hx-swap="morph"
			hx-sync="this:replace"
		>
			<div class="mtc-card">
				<div class="mtc-hdr">MTC +0.5 m</div>
				<div class="mtc-body">
					<div class="mtc-cell">
						<label>Draft, m</label>
						<input x-bind:placeholder="mtcDraftP" type="number" name={ fmt.Sprintf("%s-%d", fields.FieldPMTCDraft, draftIndex) } step="any" value={ format.FloatOrEmpty(draft.MTCRows[0].Draft) }/>
					</div>
					<div class="mtc-cell">
						<label>MTC, MT/m</label>
						@components.XInput(fmt.Sprintf("%s-%d", fields.FieldPMTC, draftIndex), draft.MTCRows[0].MTC)
					</div>
				</div>
			</div>
			<div class="mtc-card">
				<div class="mtc-hdr">MTC -0.5 m</div>
				<div class="mtc-body">
					<div class="mtc-cell">
						<label>Draft, m</label>
						<input x-bind:placeholder="mtcDraftN" type="number" name={ fmt.Sprintf("%s-%d", fields.FieldNMTCDraft, draftIndex) } placeholder="0.000" step="any" value={ format.FloatOrEmpty(draft.MTCRows[1].Draft) }/>
					</div>
					<div class="mtc-cell">
						<label>MTC, MT/m</label>
						@components.XInput(fmt.Sprintf("%s-%d", fields.FieldNMTC, draftIndex), draft.MTCRows[1].MTC)
					</div>
				</div>
				@DeltaMtc(dp.Survey, draftIndex, dr, false)
			</div>
		</div>
	</div>
}

templ LBM(dr types.DraftResult, draftIndex int, isOOB bool) {
	<span
		class="sec-title-mmc"
		id={ fmt.Sprintf("%s-%d", constants.LBM, draftIndex) }
		if isOOB {
			hx-swap-oob="true"
		}
	>
		LBM { dr.LBM }m
	</span>
}

templ MMCRow(survey types.Survey, draftIndex int, dr types.DraftResult, isOOB bool) {
	<div
		class="hydro-row"
		id={ fmt.Sprintf("%s-%d", constants.MMCRow, draftIndex) }
		if isOOB {
			hx-swap-oob="true"
		}
	>
		<div class="hydro-grid-cell hydro-grid-cell--mmc hydro-grid-cell--label">MMC</div>
		<div class="hydro-grid-cell hydro-grid-cell--mmc">{ dr.MMC }</div>
		<div class="hydro-grid-cell hydro-grid-cell--mmc">{ dr.Hydrostatics.Displacement }</div>
		<div class="hydro-grid-cell hydro-grid-cell--mmc">{ dr.Hydrostatics.TPC }</div>
		<div class="hydro-grid-cell hydro-grid-cell--mmc">{ format.LCFWithDir(dr.Hydrostatics.LCF) }</div>
	</div>
}

templ DeltaMtc(survey types.Survey, draftIndex int, dr types.DraftResult, isOOB bool) {
	<div
		class="mtc-delta"
		id={ fmt.Sprintf("%s-%d", constants.DelataMtc, draftIndex) }
		if isOOB {
			hx-swap-oob="true"
		}
	>ΔMTC: { dr.DeltaMTC }</div>
}
