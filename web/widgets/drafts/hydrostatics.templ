package drafts

import (
	"fmt"
	"github.com/AVZotov/draft-survey/internal/calculation"
	"github.com/AVZotov/draft-survey/internal/constants"
	"github.com/AVZotov/draft-survey/internal/format"
	"github.com/AVZotov/draft-survey/internal/types"
	"github.com/AVZotov/draft-survey/web/components"
)

templ Hydrostatics(dp components.DraftPageProps, draftIndex int) {
	{{ draft := dp.Survey.Drafts[draftIndex] }}
	<!-- Hydrostatic data -->
	<div class="hydro-section">
		<div class="sec-title">
			<span>Hydrostatic Data</span>
			<span>
				<span class="sec-title-mmc">MMC — m</span>
				<span class="sec-title-method">{ format.MMCShortFormula(dp.Survey.VesselData.VesselType) } { format.LBPCorrection(dp.Survey.VesselData.CorrectionMethod) }</span>
			</span>
		</div>
		<div
			class="hydro-grid"
			hx-headers={ fmt.Sprintf(`{"%s": "%s"}`, constants.HXDraftBlock, constants.HydrostaticsBlock) }
			hx-put={ fmt.Sprintf("/api/v1/survey/%s/draft/%d", dp.Survey.ID, draftIndex) }
			hx-target={ fmt.Sprintf("#%s-%d", constants.MMCRow, draftIndex) }
			hx-include={ fmt.Sprintf("#%s-%d, #%s-%d", constants.UHydroRow, draftIndex, constants.LHydroRow, draftIndex) }
			hx-trigger="change changed delay:500ms"
			hx-sync="this:replace"
		>
			<!-- Header row -->
			<div class="hydro-grid-cell hydro-grid-cell--header"></div>
			<div class="hydro-grid-cell hydro-grid-cell--header">Draft, m</div>
			<div class="hydro-grid-cell hydro-grid-cell--header">Displ, MT</div>
			<div class="hydro-grid-cell hydro-grid-cell--header">TPC, MT/cm</div>
			<div class="hydro-grid-cell hydro-grid-cell--header">LCF / LCA, m</div>
			<!-- Upper row -->
			<div
				class="hydro-row"
				id={ fmt.Sprintf("%s-%d", constants.UHydroRow, draftIndex) }
			>
				<div class="hydro-grid-cell hydro-grid-cell--label">Upper</div>
				<div class="hydro-grid-cell">
					<input name={ fmt.Sprintf("%s-%d", constants.UDraft, draftIndex) } value={ format.FloatOrEmpty(draft.HydrostaticRows[0].Draft) } type="number" placeholder="0.000" step="any"/>
				</div>
				<div class="hydro-grid-cell">
					<input name={ fmt.Sprintf("%s-%d", constants.UDisp, draftIndex) } value={ format.FloatOrEmpty(draft.HydrostaticRows[0].Displacement) } type="number" placeholder="0.000" step="any"/>
				</div>
				<div class="hydro-grid-cell">
					<input name={ fmt.Sprintf("%s-%d", constants.UTpc, draftIndex) } value={ format.FloatOrEmpty(draft.HydrostaticRows[0].TPC) } type="number" placeholder="0.000" step="any"/>
				</div>
				<div class="hydro-grid-cell lcf-field">
					<input name={ fmt.Sprintf("%s-%d", constants.ULcfLca, draftIndex) } value={ format.FloatOrEmpty(draft.HydrostaticRows[0].LCF) } type="number" placeholder="0.000" step="any"/>
					<select class="di-badge" name={ fmt.Sprintf("%s-%d", constants.ULcfDir, draftIndex) }>
						<option value="" selected?={ draft.HydrostaticRows[0].LCFDirection == types.LCFDirection("") }>—</option>
						<option value={ types.LCFDirectionForward } selected?={ draft.HydrostaticRows[0].LCFDirection == types.LCFDirectionForward }>{ types.LCFDirectionForward }</option>
						<option value={ types.LCFDirectionAft } selected?={ draft.HydrostaticRows[0].LCFDirection == types.LCFDirectionAft }>{ types.LCFDirectionAft }</option>
						<option value={ types.LCFDirectionFromAP } selected?={ draft.HydrostaticRows[0].LCFDirection == types.LCFDirectionFromAP }>{ types.LCFDirectionFromAP }</option>
					</select>
				</div>
			</div>
			<!-- MMC row -->
			@MMCRow(dp.Survey, draftIndex, false)
			<!-- Lower row -->
			<div
				class="hydro-row"
				id={ fmt.Sprintf("%s-%d", constants.LHydroRow, draftIndex) }
			>
				<div class="hydro-grid-cell hydro-grid-cell--label">Lower</div>
				<div class="hydro-grid-cell">
					<input type="number" name={ fmt.Sprintf("%s-%d", constants.LDraft, draftIndex) } placeholder="0.000" step="any" value={ format.FloatOrEmpty(draft.HydrostaticRows[1].Draft) }/>
				</div>
				<div class="hydro-grid-cell">
					<input type="number" name={ fmt.Sprintf("%s-%d", constants.LDisp, draftIndex) } placeholder="0.000" step="any" value={ format.FloatOrEmpty(draft.HydrostaticRows[1].Displacement) }/>
				</div>
				<div class="hydro-grid-cell">
					<input type="number" name={ fmt.Sprintf("%s-%d", constants.LTpc, draftIndex) } placeholder="0.000" step="any" value={ format.FloatOrEmpty(draft.HydrostaticRows[1].TPC) }/>
				</div>
				<div class="hydro-grid-cell lcf-field">
					<input type="number" name={ fmt.Sprintf("%s-%d", constants.LLcfLca, draftIndex) } placeholder="0.000" step="any" value={ format.FloatOrEmpty(draft.HydrostaticRows[1].LCF) }/>
					<select class="di-badge" name={ fmt.Sprintf("%s-%d", constants.LLcfDir, draftIndex) }>
						<option value="" selected?={ draft.HydrostaticRows[1].LCFDirection == types.LCFDirection("") }>—</option>
						<option value={ types.LCFDirectionForward } selected?={ draft.HydrostaticRows[1].LCFDirection == types.LCFDirectionForward }>{ types.LCFDirectionForward }</option>
						<option value={ types.LCFDirectionAft } selected?={ draft.HydrostaticRows[1].LCFDirection == types.LCFDirectionAft }>{ types.LCFDirectionAft }</option>
						<option value={ types.LCFDirectionFromAP } selected?={ draft.HydrostaticRows[1].LCFDirection == types.LCFDirectionFromAP }>{ types.LCFDirectionFromAP }</option>
					</select>
				</div>
			</div>
		</div>
		<div
			class="mtc-grid"
			hx-headers={ fmt.Sprintf(`{"%s": "%s"}`, constants.HXDraftBlock, constants.HydrostaticsBlock) }
			hx-trigger="change changed delay:500ms"
			hx-put={ fmt.Sprintf("/api/v1/survey/%s/draft/%d", dp.Survey.ID, draftIndex) }
			hx-include="this"
			hx-target={ fmt.Sprintf("#%s-%d", constants.DelataMtc, draftIndex) }
			hx-select={ fmt.Sprintf("#%s-%d", constants.DelataMtc, draftIndex) }
			hx-swap="morph"
			hx-sync="this:replace"
		>
			<div class="mtc-card">
				<div class="mtc-hdr">MTC +0.5 m</div>
				<div class="mtc-body">
					<div class="mtc-cell">
						<label>Draft, m</label>
						<input type="number" name={ fmt.Sprintf("%s-%d", constants.PMtcDraft, draftIndex) } placeholder="0.000" step="any" value={ format.FloatOrEmpty(draft.MTCRows[0].Draft) }/>
					</div>
					<div class="mtc-cell">
						<label>MTC, MT/m</label>
						<input type="number" name={ fmt.Sprintf("%s-%d", constants.PMtc, draftIndex) } placeholder="0.000" step="any" value={ format.FloatOrEmpty(draft.MTCRows[0].MTC) }/>
					</div>
				</div>
			</div>
			<div class="mtc-card">
				<div class="mtc-hdr">MTC -0.5 m</div>
				<div class="mtc-body">
					<div class="mtc-cell">
						<label>Draft, m</label>
						<input type="number" name={ fmt.Sprintf("%s-%d", constants.NMtcDraft, draftIndex) } placeholder="0.000" step="any" value={ format.FloatOrEmpty(draft.MTCRows[1].Draft) }/>
					</div>
					<div class="mtc-cell">
						<label>MTC, MT/m</label>
						<input type="number" name={ fmt.Sprintf("%s-%d", constants.NMtc, draftIndex) } placeholder="0.000" step="any" value={ format.FloatOrEmpty(draft.MTCRows[1].MTC) }/>
					</div>
				</div>
				@DeltaMtc(dp.Survey, draftIndex, false)
			</div>
		</div>
	</div>
}

templ MMCRow(survey types.Survey, draftIndex int, isOOB bool) {
	{{ cd := calculation.CalcDraft(survey.Drafts[draftIndex], survey.VesselData) }}
	<div
		class="hydro-row"
		id={ fmt.Sprintf("%s-%d", constants.MMCRow, draftIndex) }
		if isOOB {
			hx-swap-oob="true"
		}
	>
		<div class="hydro-grid-cell hydro-grid-cell--mmc hydro-grid-cell--label">MMC</div>
		<div class="hydro-grid-cell hydro-grid-cell--mmc">{ cd.MMC }</div>
		<div class="hydro-grid-cell hydro-grid-cell--mmc">{ cd.Hydrostatics.Displacement }</div>
		<div class="hydro-grid-cell hydro-grid-cell--mmc">{ cd.Hydrostatics.TPC }</div>
		<div class="hydro-grid-cell hydro-grid-cell--mmc">{ format.LCFWithDir(cd.Hydrostatics.LCF) }</div>
	</div>
}

templ DeltaMtc(survey types.Survey, draftIndex int, isOOB bool) {
	{{ cd := calculation.CalcDraft(survey.Drafts[draftIndex], survey.VesselData) }}
	<div
		class="mtc-delta"
		id={ fmt.Sprintf("%s-%d", constants.DelataMtc, draftIndex) }
		if isOOB {
			hx-swap-oob="true"
		}
	>ΔMTC: { cd.DeltaMTC }</div>
}
