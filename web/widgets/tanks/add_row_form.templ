package tanks

import (
	"github.com/AVZotov/draft-survey/data/dictionaries"
	"github.com/AVZotov/draft-survey/internal/handler/fields"
	"github.com/AVZotov/draft-survey/internal/handler/routes"
)

templ AddRowForm(surveyID string, draftIndex int, isBW bool, isOOB bool) {
	{{
		rowID := "add-fw-row"
		addURL := routes.APITankFWAdd(surveyID, draftIndex)
		tankTypes := dictionaries.FreshWaterTankTypes
		label := "Add FW tank"
		bodyID := FWTanksBodyID
		if isBW {
			rowID = "add-bw-row"
			addURL = routes.APITankBWAdd(surveyID, draftIndex)
			tankTypes = dictionaries.BallastWaterTankTypes
			label = "Add BW tank"
			bodyID = BWTanksBodyID
		}
	}}
	<div
		id={ rowID }
		class="add-row"
		if isOOB {
			hx-swap-oob="outerHTML"
		}
	>
		<div class="add-row-fields">
			<div class="add-field">
				<label class="add-field-label">Type</label>
				<div class="add-select-wrap">
					<select class="add-sel" name={ fields.FieldTankType } id="new-tank-type">
						for _, tankType := range tankTypes {
							<option value={ tankType }>{ tankType }</option>
						}
					</select>
					<svg class="add-sel-arrow" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"></path></svg>
				</div>
			</div>
			<div class="add-row-sep"></div>
			<div class="add-field add-field--name">
				<label class="add-field-label">Name</label>
				<input
					class="add-inp"
					type="text"
					name={ fields.FieldTankName }
					placeholder="e.g. 1S, 2P, Centre…"
					autocomplete="off"
				/>
			</div>
		</div>
		<button
			class="add-btn"
			id={ rowID + "-btn" }
			type="button"
			hx-post={ addURL }
			hx-include="closest .add-row"
			hx-target={ "#" + bodyID }
			hx-swap="beforeend"
		>
			<svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg>
			{ label }
		</button>
	</div>
}
