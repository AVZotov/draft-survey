package tanks

import (
	"fmt"
	"github.com/AVZotov/draft-survey/web/components"
)

templ TanksActionBar(props components.TanksPageProps) {
	<div class="action-bar">
		<div class="ab-info"><span class="ab-vessel">OCEAN CHEERS</span><span class="ab-meta">IMO 9233387 · Loading · Vanino, Russia</span></div>
		<a
			href={ fmt.Sprintf("/survey/%s/draft", props.Survey.ID) }
			class="btn btn-primary"
		>
			Back to DRAFT
			<svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
		</a>
	</div>
}
