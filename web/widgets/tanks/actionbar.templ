package tanks

import (
	"fmt"
	"github.com/AVZotov/draft-survey/internal/calculation"
	"github.com/AVZotov/draft-survey/internal/format"
	"github.com/AVZotov/draft-survey/internal/handler/routes"
	"github.com/AVZotov/draft-survey/web/components"
)

// ABTotalsID returns the DOM id ABTotals renders under, scoped per draft
// index so an EventTankCalc SSE fragment for one draft's Tanks page never
// clobbers another draft's identically-shaped totals block in another tab.
func ABTotalsID(draftIndex int) string {
	return fmt.Sprintf("ab-totals-%d", draftIndex)
}

templ TanksActionBar(tp components.TanksPageProps) {
	{{
		draft := tp.Survey.Drafts[tp.DraftIndex]
		results := calculation.CalcDraft(draft, tp.Survey.VesselData)
	}}
	<div class="action-bar">
		<div class="ab-info">
			<span class="ab-vessel">{ tp.Survey.VesselData.Name }</span><span class="ab-meta">{ fmt.Sprintf("IMO %s · %s · %s", tp.Survey.VesselData.IMO, tp.Survey.CargoOperation.Operation, tp.Survey.Country.Name) }</span>
		</div>
		@ABTotals(format.WeightFormatted(results.TotalBwTanksWeight), format.WeightFormatted(results.TotalFwTanksWeight), tp.DraftIndex, false)
		<a
			href={ routes.Draft(tp.Survey.ID) }
			class="btn btn-primary"
		>
			Back to DRAFT
			<svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
		</a>
	</div>
}

templ ABTotals(totalBW, totalFW string, draftIndex int, isOOB bool) {
	<div
		id={ ABTotalsID(draftIndex) }
		class="blk-totals"
		if isOOB {
			hx-swap-oob="morph"
		}
	>
		<div class="ab-info-total ab-info--bw">
			<span class="total-chip-lbl">Total Ballast Water</span>
			<span class="total-chip-val">{ totalBW } MT</span>
		</div>
		<div class="ab-info-total ab-info--fw">
			<span class="total-chip-lbl">Total Fresh Water</span>
			<span class="total-chip-val">{ totalFW } MT</span>
		</div>
	</div>
}
