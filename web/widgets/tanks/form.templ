package tanks

import (
	"fmt"
	"github.com/AVZotov/draft-survey/internal/calculation"
	"github.com/AVZotov/draft-survey/internal/constants"
	"github.com/AVZotov/draft-survey/internal/format"
	"github.com/AVZotov/draft-survey/web/components"
)

templ Form(lp components.LayoutProps, tp components.TanksPageProps) {
	{{
		draft := tp.Survey.Drafts[tp.DraftIndex]
		results := calculation.CalcDraft(draft, tp.Survey.VesselData)
		bwTitle := "Ballast Water Tanks"
		fwTitle := "Fresh Water Tanks"
		bwTWeight := format.WeightFormatted(results.TotalBwTanksWeight)
		fwTWeight := format.WeightFormatted(results.TotalFwTanksWeight)
	}}
	<main class="page-main">
		<div class="page-wrap">
			<div class="page-top">
				<a
					href={ fmt.Sprintf("/survey/%s/draft", tp.Survey.ID) }
					class="back-link"
				>
					<svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg>
					Back to Draft Readings
				</a>
				<h1 class="page-title">BW / FW Tanks</h1>
				<p class="page-meta">
					{ fmt.Sprintf("%s · IMO %s · %s · %s", 
						tp.Survey.VesselData.Name, 
						tp.Survey.VesselData.IMO, 
						tp.Survey.CargoOperation.Operation, 
						tp.Survey.Country.Name) }
				</p>
			</div>
			<!-- DENSITY BAR -->
			<div
				class="density-bar"
				hx-headers={ fmt.Sprintf(`{"%s": "%s"}`, constants.HXTankType, constants.BWTank) }
			>
				<span class="density-bar-label">BW Density</span>
				<div
					class="density-groups"
				>
					<div class="dg dg--ini">
						<span class="dg-lbl">{ draft.Type }</span>
						<input class="den-in" id="dockwater-density" name="dockwater-density" value={ format.FloatOrEmpty(draft.Density) } type="number" placeholder="0.000" step="any"/>
						<span class="den-hint">t/m³</span>
					</div>
					<button
						class="btn btn-primary"
						type="button"
						hx-include="previous [name='dockwater-density']"
						hx-put={ fmt.Sprintf("/api/v1/survey/%s/tanks/%d", tp.Survey.ID, tp.DraftIndex) }
						hx-swap="none"
					>
						Apply Density
						<svg viewBox="0 0 24 24" width="13" height="13" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="4" y="2" width="16" height="20" rx="2"></rect>
							<line x1="8" y1="8" x2="16" y2="8"></line>
							<line x1="8" y1="12" x2="16" y2="12"></line>
							<line x1="8" y1="16" x2="12" y2="16"></line>
						</svg>
					</button>
				</div>
				<span class="density-bar-note">Applied to BW tanks with empty density. Override per-tank if needed.</span>
			</div>
			<!-- ═══ BALLAST WATER ══════════════════════════════════════════ -->
			<div
				class="tank-block tank-block--bw"
				hx-headers={ fmt.Sprintf(`{"%s": "%s"}`, constants.HXTankType, constants.BWTank) }
			>
				@TrimListAlert(tp)
				@TableFormHeader(constants.BwTableHeaderID, bwTitle, bwTWeight, draft.Type, false)
				@Block(tp, true)
				@AddRowForm(tp.Survey.ID, tp.DraftIndex, false)
			</div>
			<!-- ═══ FRESH WATER ════════════════════════════════════════════ -->
			<div
				class="tank-block tank-block--fw"
				hx-headers={ fmt.Sprintf(`{"%s": "%s"}`, constants.HXTankType, constants.FWTank) }
			>
				@TableFormHeader(constants.FwTableHeaderID, fwTitle, fwTWeight, draft.Type, false)
				@Block(tp, false)
				@AddRowForm(tp.Survey.ID, tp.DraftIndex, false)
			</div>
		</div>
	</main>
}
