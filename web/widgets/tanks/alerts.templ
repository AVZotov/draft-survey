package tanks

import (
	"github.com/AVZotov/draft-survey/internal/format"
	"github.com/AVZotov/draft-survey/web/components"
)

templ TrimListAlert(tp components.TanksPageProps) {
	if tp.Trim == nil || tp.List == nil {
		@danger()
	} else {
		@warning(tp)
	}
}

templ danger() {
	<div class="corr-banner corr-banner--danger">
		<svg viewBox="0 0 24 24">
			<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M15 9l-6 6M9 9l6 6"></path></svg>
		</svg>
		No draft Marks! Trim & List are not set. Return to Drafts
	</div>
}

templ warning(tp components.TanksPageProps) {
	<div class="corr-banner corr-banner--warning">
		<svg viewBox="0 0 24 24">
			<svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><path d="M12 9v4M12 17h.01"></path></svg>
		</svg>
		Volumes must be corrected for Trim ({ format.FloatOrEmpty(tp.Trim) }m { tp.TrimDir }) and List ({ format.FloatOrEmpty(tp.List) }° { tp.ListDir }). Please use Vessel's tables for corrections
	</div>
}
