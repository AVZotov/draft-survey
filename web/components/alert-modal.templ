package components

templ AlertModal() {
	<div class="confirm-modal" x-data>
		<div class="confirm-modal__header">
			<div class="confirm-modal__icon" style="background: var(--info-light); color: var(--info-accent);">
				@IconInfo(16)
			</div>
			<div class="confirm-modal__titles">
				<span class="confirm-modal__title" x-text="$store.alert.header"></span>
				<span class="confirm-modal__subtitle" x-text="$store.alert.message"></span>
			</div>
		</div>
		<div class="confirm-modal__footer">
			<button
				class="btn btn-primary"
				type="button"
				x-on:click="$store.alert.ok()"
			>
				OK
			</button>
		</div>
	</div>
}
