# Ignore everything
*

# Allow directories
!*/

# Allow Go source files
!**/*.go
!go.mod
!go.sum

# Allow configs (but not local overrides)
!**/*.yaml
!**/*.yml
!**/*.toml
!*.env.example
!.gitignore

# Allow web assets
!**/*.html
!**/*.css
!**/*.js
!**/*.woff2

# Allow documentation
!docs/ARCHITECTURE.md
!docs/CALCULATION.md
!docs/glossary_en.md
!docs/glossary_ru.md
!docs/ROADMAP.md
!**/*.txt
!THIRD_PARTY_NOTICES

# Allow dictionaries
!data/dictionaries/*.json

# Allow verify-tool test data (raw/ stays ignored — see "Always ignore" below)
!cmd/verify/testdata/*.json

# Allow GitHub Actions
!.github/workflows/*.yml

# Allow Makefile and gitkeep
!Makefile
!**/.gitkeep

# Allow templ files
!*.templ

# Allow favicons
!favicon*.png

# Always ignore — sensitive and generated
.env
configs/local.yaml
configs/local.toml
data/surveys/
data/temp/
data/backups/
*.log
*.db
*.sqlite
bin/
dist/
.idea/
.vscode/
.claude/
UI design/
users/
htmx-cheatsheet.md
htmx-ref.md
cmd/verify/testdata/raw/
